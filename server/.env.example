# Copy to server/.env and fill in. Bun loads .env automatically.
LLM_API_KEY=your-api-key
# OpenAI-compatible endpoint, e.g. https://api.openai.com/v1 or https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.deepseek.com
# Must accept image input, e.g. gpt-4o or a Claude/Gemini vision model via a compatible gateway
LLM_MODEL=deepseek-flash
PORT=3000
# Maximum number of PDF pages to process
MAX_PAGES=10
